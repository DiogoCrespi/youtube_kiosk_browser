{
  "manifest_version": 2,
  "name": "YouTube Background Playback Fix",
  "version": "1.0.0",
  "description": "Permite reprodução contínua de áudio do YouTube em segundo plano e com tela desligada",
  "browser_specific_settings": {
    "gecko": {
      "id": "background-play-fix@kiosk.browser"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtubekids.com/*"
      ],
      "js": ["content.js"],
      "css": ["amoled_theme.css", "pip_isolation.css", "inapp_miniplayer.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
