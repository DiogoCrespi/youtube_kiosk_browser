{
  "manifest_version": 2,
  "name": "AdBlocker for YouTube",
  "version": "1.0.0",
  "description": "Bloqueador de anúncios embutido e acelerador de reprodução para YouTube Mobile",
  "browser_specific_settings": {
    "gecko": {
      "id": "adblock-youtube@kiosk.browser"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtubekids.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
